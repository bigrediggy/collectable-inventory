# ---- Required ----
ANTHROPIC_API_KEY=sk-ant-...
# Vision-capable model. Sonnet is a good cost/quality balance for this.
ANTHROPIC_MODEL=claude-sonnet-4-5
# Only if your key is a multi-workspace key (400 "not scoped to a workspace").
# Easier: create the key scoped to a single workspace and leave this blank.
ANTHROPIC_WORKSPACE_ID=

# ---- eBay (free developer account: https://developer.ebay.com) ----
# Create a "Production" keyset. Browse API only needs client credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Set to "sandbox" while testing, "production" for real comps
EBAY_ENV=production
# Your eBay Partner Network campaign id (optional; leave blank)
EBAY_CAMPAIGN_ID=

# ---- Discogs (free personal token: https://www.discogs.com/settings/developers) ----
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=CollectableInventory/0.1 +https://example.com

# ---- Reverb (instruments; free personal token: reverb.com → Settings → My API tokens) ----
REVERB_TOKEN=

# ---- PCGS Public API (coins; free token at https://www.pcgs.com/publicapi) ----
# Price guide + auction prices realized. Low daily call limit, so lookups are cached.
PCGS_TOKEN=

# ---- Metal spot prices for coin melt floors ----
# Free key at https://metals.dev (100 calls/month; we cache 12h). Optional.
METALS_DEV_API_KEY=
# Manual fallback if you'd rather not sign up — USD per troy oz, update occasionally.
SPOT_SILVER=
SPOT_GOLD=

# ---- Supabase (same values as web/.env) — lets the API cache spot prices and
#      PCGS lookups across restarts so daily API quotas aren't wasted ----
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Server ----
PORT=8787
# Comma-separated origins allowed to call this API (your PWA's URL)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Simple shared secret the PWA sends as "x-app-key" so strangers can't burn your API credits
APP_KEY=change-me-to-something-random
