# ---- Required ----
ANTHROPIC_API_KEY=
# Vision-capable model. Sonnet is a good cost/quality balance for this.
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- eBay (free developer account: https://developer.ebay.com) ----
# Create a "Production" keyset. Browse API only needs client credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Set to "sandbox" while testing, "production" for real comps
EBAY_ENV=production
# Your eBay Partner Network campaign id (optional; leave blank)
EBAY_CAMPAIGN_ID=

# ---- Discogs (free personal token: https://www.discogs.com/settings/developers) ----
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=

# ---- Server ----
PORT=8787
# Comma-separated origins allowed to call this API (your PWA's URL)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Simple shared secret the PWA sends as "x-app-key" so strangers can't burn your API credits
APP_KEY=
